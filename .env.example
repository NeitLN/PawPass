# PawPass — biến môi trường
# Copy file này thành `.env` rồi điền giá trị thật. `.env` đã bị .gitignore chặn.
# Xem docs/SOURCE-OF-TRUTH.md §13.1

# URL project Supabase (một project duy nhất cho cả dev và production)
VITE_SUPABASE_URL=https://nzcnojcnnfiqeujfhccx.supabase.co

# Publishable (anon) key — an toàn khi nằm trong desktop bundle vì mọi bảng đã bật RLS.
# TUYỆT ĐỐI KHÔNG đặt service_role key vào đây. Nếu một biến nào đó là secret thật,
# nó không thuộc về desktop bundle — dừng lại và thiết kế lại.
VITE_SUPABASE_PUBLISHABLE_KEY=
