# --- build ---
node_modules/
dist/
dist-ssr/
coverage/
*.local
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# --- Tauri / Rust ---
src-tauri/target/
src-tauri/gen/

# --- Supabase CLI local state (nested supabase/.gitignore also lists these, but
# tools like Prettier don't walk nested .gitignore files, so they're repeated here) ---
supabase/.temp/
supabase/.branches/

# --- DỮ LIỆU NHẠY CẢM ---
# SOURCE-OF-TRUTH.md §11.9: commit không được kèm file .db, .enc, .env.
# Đây là kho mật khẩu — một lần lỡ tay là lộ vĩnh viễn trong lịch sử git.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.enc
.env
.env.*
!.env.example
browser-profiles/
backups/

# --- editor / OS ---
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- brainstorming visual companion ---
.superpowers/

# --- log files (from create-tauri-app scaffold) ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.sw?

# --- VS Code local settings (keep only the shared extension recommendations) ---
.vscode/*
!.vscode/extensions.json

# --- Claude Code session state (worktrees, plans dir) — never project source ---
.claude/
